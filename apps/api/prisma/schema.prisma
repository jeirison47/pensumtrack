generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?  @unique
  passwordHash String?
  displayName  String
  auth0Id      String?  @unique
  authProvider String   @default("local")
  isActive     Boolean  @default(true)
  isAdmin      Boolean  @default(false)
  planId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings StudentProfile?
  plan     Plan?           @relation(fields: [planId], references: [id])
}

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  features PlanFeature[]
  users    User[]
}

model PlanFeature {
  id         String @id @default(cuid())
  planId     String
  featureKey String

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model University {
  id        String   @id @default(cuid())
  name      String
  shortName String
  country   String   @default("DO")
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  careers Career[]
}

model Career {
  id                String   @id @default(cuid())
  name              String
  universityId      String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  // Legacy version fields — kept nullable during migration, moved to Pensum
  totalCredits      Int?
  durationSemesters Int?
  periodType        String?
  year              Int?

  university University       @relation(fields: [universityId], references: [id])
  subjects   Subject[]
  profiles   StudentProfile[]
  pensums    Pensum[]
}

model Pensum {
  id                String   @id @default(cuid())
  careerId          String
  year              Int?
  periodType        String   @default("semester")
  totalCredits      Int
  durationSemesters Int
  isActive          Boolean  @default(false)
  createdAt         DateTime @default(now())

  career   Career           @relation(fields: [careerId], references: [id])
  subjects Subject[]
  profiles StudentProfile[]
}

model Subject {
  code          String
  name          String
  credits       Int
  semester      Int
  area          String?
  careerId      String
  pensumId      String?
  prerequisites String[]
  corequisites  String[]
  createdAt     DateTime @default(now())

  career Career  @relation(fields: [careerId], references: [id])
  pensum Pensum? @relation(fields: [pensumId], references: [id])

  @@id([code, careerId])
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  careerId        String
  pensumId        String?
  currentSemester Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id])
  career        Career           @relation(fields: [careerId], references: [id])
  pensum        Pensum?          @relation(fields: [pensumId], references: [id])
  subjects      StudentSubject[]
  preselections Preselection[]
}

model StudentSubject {
  id          String        @id @default(cuid())
  profileId   String
  subjectCode String
  status      SubjectStatus @default(PENDING)
  grade       Float?
  period      String?
  updatedAt   DateTime      @updatedAt

  profile StudentProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, subjectCode])
}

model Preselection {
  id        String             @id @default(cuid())
  profileId String
  period    String?
  label     String?
  startDate DateTime?
  endDate   DateTime?
  status    PreselectionStatus @default(OPEN)
  subjects  String[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  profile StudentProfile @relation(fields: [profileId], references: [id])
}

enum PreselectionStatus {
  OPEN
  CONFIRMED
  CLOSED
}

enum SubjectStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  PRESELECTED
}
