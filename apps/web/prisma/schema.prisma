generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?
  displayName     String
  auth0Id         String?  @unique
  authProvider    String   @default("local")
  isActive        Boolean  @default(true)
  isAdmin         Boolean  @default(false)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  planId          String?
  planExpiresAt   DateTime?
  trialUsedAt     DateTime?
  username        String?  @unique

  profiles                StudentProfile[]
  plan                    Plan?                    @relation(fields: [planId], references: [id])
  pensumRequests          PensumRequest[]
  emailVerifications      EmailVerification[]
  professorRatings        ProfessorRating[]
  professorComments       ProfessorComment[]
  professorRequests       ProfessorRequest[]
  professorUpdateRequests ProfessorUpdateRequest[]
  planUpgradeRequests     PlanUpgradeRequest[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Códigos de restablecimiento de contraseña (flujo "olvidé mi contraseña").
model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0) // intentos de validación del código
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// Registro pendiente: se guarda aquí hasta que el usuario verifica su correo.
// El User real solo se crea al validar el OTP, para no ensuciar la base con bots.
model PendingRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String
  code         String
  expiresAt    DateTime
  sendCount    Int      @default(1) // OTPs enviados (inicial = 1)
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model Plan {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  price       Float?
  isDefault   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  features    PlanFeature[]
  users              User[]
  planUpgradeRequests PlanUpgradeRequest[]
}

model PlanFeature {
  id         String @id @default(cuid())
  planId     String
  featureKey String
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model University {
  id        String   @id @default(cuid())
  name      String
  shortName String
  country   String   @default("DO")
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  careers            Career[]
  professorTeachings ProfessorTeaching[]
  professorRequests  ProfessorRequest[]
}

model Career {
  id                String   @id @default(cuid())
  name              String
  universityId      String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  // Legacy version fields — kept nullable during migration, moved to Pensum
  totalCredits      Int?
  durationSemesters Int?
  periodType        String?
  year              Int?

  university University       @relation(fields: [universityId], references: [id])
  subjects   Subject[]
  profiles   StudentProfile[]
  pensums    Pensum[]
}

model Pensum {
  id                String   @id @default(cuid())
  careerId          String
  year              Int?
  periodType        String   @default("semester")
  totalCredits      Int
  durationSemesters Int
  isActive          Boolean  @default(false)
  createdAt         DateTime @default(now())

  career   Career           @relation(fields: [careerId], references: [id])
  subjects Subject[]
  profiles StudentProfile[]
}

model Subject {
  code          String
  name          String
  credits       Int
  semester      Int
  area          String?
  careerId      String
  pensumId      String?
  prerequisites String[]
  corequisites  String[]
  createdAt     DateTime @default(now())

  career Career  @relation(fields: [careerId], references: [id])
  pensum Pensum? @relation(fields: [pensumId], references: [id])

  @@id([code, careerId])
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String
  careerId        String
  pensumId        String?
  currentSemester Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id])
  career        Career           @relation(fields: [careerId], references: [id])
  pensum        Pensum?          @relation(fields: [pensumId], references: [id])
  subjects      StudentSubject[]
  preselections Preselection[]
}

model StudentSubject {
  id          String        @id @default(cuid())
  profileId   String
  subjectCode String
  status      SubjectStatus @default(PENDING)
  grade       Float?
  period      String?
  updatedAt   DateTime      @updatedAt

  profile StudentProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, subjectCode])
}

model Preselection {
  id        String             @id @default(cuid())
  profileId String
  period    String?
  label     String?
  startDate DateTime?
  endDate   DateTime?
  status    PreselectionStatus @default(OPEN)
  subjects  String[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  profile StudentProfile @relation(fields: [profileId], references: [id])
}

enum PreselectionStatus {
  OPEN
  CONFIRMED
  CLOSED
}

enum SubjectStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  PRESELECTED
}

model PensumRequest {
  id         String              @id @default(cuid())
  userId     String
  university String
  career     String
  year       Int?
  periodType String              @default("semester")
  link       String?
  comment    String?
  status     PensumRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum PensumRequestStatus {
  PENDING
  IN_REVIEW
  COMPLETED
  REJECTED
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Rate limiting por ventana fija. La clave es "<accion>:<identificador>"
// (ej. "register:1.2.3.4"). Se limpia periódicamente desde el cron.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// ─── Profesores ───────────────────────────────────────────────────────────────

enum ScheduleType {
  MORNING
  AFTERNOON
  NIGHT
}

enum ProfessorStatus {
  PENDING
  ACTIVE
  REJECTED
}

model Professor {
  id        String          @id @default(cuid())
  name      String
  photoUrl  String?
  bio       String?
  status    ProfessorStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  teachings      ProfessorTeaching[]
  ratings        ProfessorRating[]
  comments       ProfessorComment[]
  updateRequests ProfessorUpdateRequest[]
}

model ProfessorTeaching {
  id           String       @id @default(cuid())
  professorId  String
  universityId String
  subjectName  String
  subjectCode  String?      // código de la materia del pensum (si calza con una real)
  schedule     ScheduleType?
  createdAt    DateTime     @default(now())

  professor  Professor  @relation(fields: [professorId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id])
  ratings    ProfessorRating[]

  @@unique([professorId, universityId, subjectName])
}

model ProfessorRating {
  id           String   @id @default(cuid())
  userId       String
  professorId  String
  teachingId   String
  puntualidad  Int
  explicacion  Int
  dominio      Int
  exigencia    Int
  personalidad Int
  apoyo        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id])
  professor Professor         @relation(fields: [professorId], references: [id], onDelete: Cascade)
  teaching  ProfessorTeaching @relation(fields: [teachingId], references: [id], onDelete: Cascade)

  @@unique([userId, teachingId])
}

model ProfessorComment {
  id          String   @id @default(cuid())
  userId      String
  professorId String
  content     String
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
}

model ProfessorRequest {
  id             String              @id @default(cuid())
  userId         String
  name           String
  universityId   String?
  universityName String?
  subjects       String[]
  schedule       ScheduleType        @default(MORNING)
  bio            String?
  comment        String?
  status         PensumRequestStatus @default(PENDING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  university University? @relation(fields: [universityId], references: [id])
}

model PlanUpgradeRequest {
  id         String   @id @default(cuid())
  userId     String
  planId     String
  method         String   // 'transfer' | 'paypal'
  confirmMethod  String   @default("app") // 'app' | 'email'
  proofUrl   String?
  proofName  String?
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
}

model ProfessorUpdateRequest {
  id          String              @id @default(cuid())
  userId      String
  professorId String
  details     String
  status      PensumRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  professor Professor @relation(fields: [professorId], references: [id])
}
