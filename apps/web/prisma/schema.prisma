generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String?
  displayName  String
  auth0Id      String?          @unique
  authProvider String           @default("local")
  isActive     Boolean          @default(true)
  isAdmin      Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  planId       String?
  username     String?          @unique
  profiles        StudentProfile[]
  plan            Plan?           @relation(fields: [planId], references: [id])
  pensumRequests  PensumRequest[]
}

model Plan {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  isDefault   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  features    PlanFeature[]
  users       User[]
}

model PlanFeature {
  id         String @id @default(cuid())
  planId     String
  featureKey String
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model University {
  id        String   @id @default(cuid())
  name      String
  shortName String
  country   String   @default("DO")
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  careers   Career[]
}

model Career {
  id                String           @id @default(cuid())
  name              String
  universityId      String
  totalCredits      Int
  durationSemesters Int
  periodType        String           @default("semester")
  year              Int?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  university        University       @relation(fields: [universityId], references: [id])
  profiles          StudentProfile[]
  subjects          Subject[]
}

model Subject {
  code          String
  name          String
  credits       Int
  semester      Int
  area          String?
  careerId      String
  prerequisites String[]
  corequisites  String[]
  createdAt     DateTime @default(now())
  career        Career   @relation(fields: [careerId], references: [id])

  @@id([code, careerId])
}

model StudentProfile {
  id              String           @id @default(cuid())
  userId          String
  careerId        String
  currentSemester Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  preselections   Preselection[]
  career          Career           @relation(fields: [careerId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  subjects        StudentSubject[]
}

model StudentSubject {
  id          String         @id @default(cuid())
  profileId   String
  subjectCode String
  status      SubjectStatus  @default(PENDING)
  grade       Float?
  period      String?
  updatedAt   DateTime       @updatedAt
  profile     StudentProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, subjectCode])
}

model Preselection {
  id        String         @id @default(cuid())
  profileId String
  subjects  String[]
  updatedAt DateTime       @updatedAt
  period    String?
  profile   StudentProfile @relation(fields: [profileId], references: [id])
}

enum PreselectionStatus {
  OPEN
  CONFIRMED
  CLOSED
}

enum SubjectStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  PRESELECTED
}

model PensumRequest {
  id         String              @id @default(cuid())
  userId     String
  university String
  career     String
  year       Int?
  periodType String              @default("semester")
  link       String?
  comment    String?
  status     PensumRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum PensumRequestStatus {
  PENDING
  IN_REVIEW
  COMPLETED
  REJECTED
}
